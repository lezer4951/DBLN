    <string name="astronomy_level_one_exam">Graduación · Nivel 1</string>
    <string name="astronomy_level_one_passed">¡Astronomía ya forma parte de tu rango!</string>
    <string name="astronomy_level_one_passed_description">Dominaste los fundamentos del Sistema Solar, desbloqueaste el Nivel 2 y activaste tu Rango Dubalin de Astronomía.</string>
    <string name="astronomy_rank_value">Rango %1$d · Astronomía</string>
    <string name="astronomy_level_two_title">Nivel 2 · Tierra, Luna y cielo</string>
    <string name="astronomy_level_two_topic">TEMA %1$02d · NIVEL 2</string>
    <string name="astronomy_level_two_hint">Relaciona cada fenómeno con su geometría: qué cuerpo gira, cuál ilumina y desde dónde observa la persona. Dibujarlo mentalmente evita memorizar sin comprender.</string>
    <string name="astronomy_go_to_cumulative_practice">Ir al repaso acumulativo</string>
    <string name="astronomy_level_two_practice">Repaso acumulativo · Niveles 0–2</string>
    <string name="astronomy_cumulative_complete">¡Repaso acumulativo completado!</string>
    <string name="astronomy_cumulative_complete_description">Conectaste el método científico, las órbitas y los fenómenos observables desde la Tierra. Tu memoria ya tiene más de una ruta para recuperar estas ideas.</string>
    <string name="astronomy_level_two_exam">Graduación · Nivel 2</string>
    <string name="astronomy_level_two_passed">¡Nivel 3 desbloqueado!</string>
    <string name="astronomy_level_two_passed_description">Ya puedes explicar los movimientos de la Tierra, las fases, los eclipses, las mareas y la orientación celeste. Tu Rango Dubalin de Astronomía subió a 2.</string>
    <string name="astronomy_level_three_title">Nivel 3 · El Sol, la luz y las estrellas</string>
    <string name="astronomy_level_three_topic">TEMA %1$02d · NIVEL 3</string>
    <string name="astronomy_level_three_hint">Primero construye la imagen física; después usa la relación o fórmula como una descripción compacta de esa imagen. No memorices símbolos que todavía no puedas explicar.</string>
    <string name="astronomy_level_three_practice">Práctica · Luz y estrellas</string>
    <string name="astronomy_stellar_practice_complete">¡Práctica estelar completada!</string>
    <string name="astronomy_stellar_practice_description">Usaste espectros, brillo, color, paralaje y el diagrama H–R como herramientas de investigación, no como una lista de definiciones.</string>
    <string name="astronomy_level_three_exam">Graduación · Nivel 3</string>
    <string name="astronomy_level_three_passed">¡Nivel 4 desbloqueado!</string>
    <string name="astronomy_level_three_passed_description">Ya puedes interpretar luz estelar, comparar luminosidades y distancias, y ubicar estrellas en el diagrama H–R. Tu Rango Dubalin de Astronomía subió a 3.</string>
    <string name="astronomy_level_four_title">Nivel 4 · Planetas y exoplanetas</string>
    <string name="astronomy_level_four_topic">TEMA %1$02d · NIVEL 4</string>
    <string name="astronomy_level_four_hint">Separa siempre tres preguntas: qué podemos medir, qué podemos inferir y qué todavía no podemos afirmar. Esa disciplina es esencial al estudiar mundos que apenas vemos.</string>
    <string name="astronomy_level_four_practice">Práctica · Detectives planetarios</string>
    <string name="astronomy_planetary_practice_complete">¡Investigación planetaria completada!</string>
    <string name="astronomy_planetary_practice_description">Combinaste densidad, órbitas, curvas de luz y espectros sin convertir una posibilidad en una certeza.</string>
    <string name="astronomy_level_four_exam">Graduación · Nivel 4</string>
    <string name="astronomy_level_four_passed">¡Nivel 5 desbloqueado!</string>
    <string name="astronomy_level_four_passed_description">Ya puedes comparar mundos, interpretar métodos de detección y evaluar biofirmas con cautela científica. Tu Rango Dubalin de Astronomía subió a 4.</string>
    <string name="astronomy_level_five_title">Nivel 5 · Vía Láctea y galaxias</string>
    <string name="astronomy_level_five_topic">TEMA %1$02d · NIVEL 5</string>
    <string name="astronomy_level_five_hint">Cambia de escala: observa qué vemos, qué movimiento medimos y qué masa debemos inferir para explicar la galaxia completa.</string>
    <string name="astronomy_level_five_practice">Práctica acumulativa · Niveles 3–5</string>
    <string name="astronomy_galactic_practice_complete">¡Mapa galáctico completado!</string>
    <string name="astronomy_galactic_practice_description">Conectaste luz estelar, sistemas planetarios y estructura galáctica. Ya puedes intentar la graduación del nivel.</string>
    <string name="astronomy_level_five_exam">Graduación · Nivel 5</string>
    <string name="astronomy_level_five_passed">¡Nivel 6 desbloqueado!</string>
    <string name="astronomy_level_five_passed_description">Ya puedes ubicar nuestro sistema, comparar galaxias e interpretar su dinámica y materia invisible. Tu Rango Dubalin de Astronomía subió a 5.</string>
    <string name="astronomy_level_six_title">Nivel 6 · Nebulosas y evolución estelar</string>
    <string name="astronomy_level_six_topic">TEMA %1$02d · NIVEL 6</string>
    <string name="astronomy_level_six_hint">Sigue siempre la cadena física: masa inicial, combustible disponible, equilibrio interno y remanente final. Así la evolución deja de ser una lista de nombres.</string>
    <string name="astronomy_level_six_practice">Práctica acumulativa · Niveles 4–6</string>
    <string name="astronomy_stellar_evolution_practice_complete">¡Ciclo estelar reconstruido!</string>
    <string name="astronomy_stellar_evolution_practice_description">Relacionaste observaciones, masa, fusión y gravedad para reconstruir el nacimiento y el destino de distintas estrellas.</string>
    <string name="astronomy_level_six_exam">Graduación · Nivel 6</string>
    <string name="astronomy_level_six_passed">¡Nivel 7 desbloqueado!</string>
    <string name="astronomy_level_six_passed_description">Ya puedes explicar cómo nacen, evolucionan y mueren las estrellas, además de relacionar sus remanentes con el origen de los elementos. Tu Rango Dubalin de Astronomía subió a 6.</string>
    <string name="astronomy_level_seven_title">Nivel 7 · Agujeros negros</string>
    <string name="astronomy_level_seven_topic">TEMA %1$02d · NIVEL 7</string>
    <string name="astronomy_level_seven_hint">Separa el agujero negro de su entorno: el horizonte no brilla, pero el gas, las estrellas y el espacio-tiempo cercanos sí dejan señales medibles.</string>
    <string name="astronomy_level_seven_practice">Práctica acumulativa · Niveles 5–7</string>
    <string name="astronomy_black_hole_practice_complete">¡Expedición al horizonte completada!</string>
    <string name="astronomy_black_hole_practice_description">Conectaste evolución estelar, núcleos galácticos, acreción y ondas gravitacionales sin confundir evidencia con especulación.</string>
    <string name="astronomy_level_seven_exam">Graduación · Nivel 7</string>
    <string name="astronomy_level_seven_passed">¡Nivel 8 desbloqueado!</string>
    <string name="astronomy_level_seven_passed_description">Ya puedes explicar horizontes, discos, chorros, métodos de detección y fusiones con rigor físico. Tu Rango Dubalin de Astronomía subió a 7.</string>
    <string name="astronomy_level_eight_title">Nivel 8 · Cosmología</string>
    <string name="astronomy_level_eight_topic">TEMA %1$02d · NIVEL 8</string>
    <string name="astronomy_level_eight_hint">Trabaja con cadenas de evidencia: qué observamos, qué modelo lo explica y qué incertidumbres permanecen. En cosmología ninguna prueba importante está aislada.</string>
    <string name="astronomy_level_eight_practice">Práctica acumulativa · Niveles 6–8</string>
    <string name="astronomy_cosmology_practice_complete">¡Historia cósmica reconstruida!</string>
    <string name="astronomy_cosmology_practice_description">Conectaste luz antigua, expansión, gravedad y estructura para reconstruir la evolución del universo sin convertir preguntas abiertas en certezas.</string>
    <string name="astronomy_level_eight_exam">Graduación · Nivel 8</string>
    <string name="astronomy_level_eight_passed">¡Nivel 9 desbloqueado!</string>
    <string name="astronomy_level_eight_passed_description">Ya puedes interpretar las principales evidencias del Big Bang, la expansión y la estructura cósmica. Tu Rango Dubalin de Astronomía subió a 8.</string>
    <string name="astronomy_level_nine_title">Nivel 9 · Exploración espacial</string>
    <string name="astronomy_level_nine_topic">TEMA %1$02d · NIVEL 9</string>
    <string name="astronomy_level_nine_hint">En cada misión separa objetivo, trayectoria, plataforma, instrumentos y riesgos. Una buena decisión técnica siempre responde a una necesidad concreta.</string>
    <string name="astronomy_level_nine_practice">Práctica acumulativa · Niveles 7–9</string>
    <string name="astronomy_space_exploration_practice_complete">¡Misión espacial completada!</string>
    <string name="astronomy_space_exploration_practice_description">Aplicaste gravedad, instrumentación y pensamiento científico para diseñar y evaluar misiones sin exagerar sus resultados.</string>
    <string name="astronomy_level_nine_exam">Graduación · Nivel 9</string>
    <string name="astronomy_level_nine_passed">¡Nivel 10 desbloqueado!</string>
    <string name="astronomy_level_nine_passed_description">Ya puedes interpretar trayectorias, plataformas, instrumentos y riesgos de una misión espacial. Tu Rango Dubalin de Astronomía subió a 9.</string>
    <string name="astronomy_level_ten_title">Nivel 10 · Astronomía avanzada</string>
    <string name="astronomy_level_ten_topic">TEMA %1$02d · NIVEL 10</string>
    <string name="astronomy_level_ten_hint">No busques únicamente la respuesta correcta: identifica qué dato la sostiene, qué alternativa se descartó y qué incertidumbre todavía limita la conclusión.</string>
    <string name="astronomy_level_ten_practice">Práctica final · Ruta completa</string>
    <string name="astronomy_advanced_practice_complete">¡Investigación final completada!</string>
    <string name="astronomy_advanced_practice_description">Integraste medición, modelos e incertidumbre para resolver casos de toda la ruta. Ya puedes presentar la graduación final.</string>
    <string name="astronomy_level_ten_exam">Graduación final · Astronomía</string>
    <string name="astronomy_level_ten_passed">¡Ruta de Astronomía completada!</string>
    <string name="astronomy_level_ten_passed_description">Dominaste la ruta completa y ya puedes construir conclusiones astronómicas basadas en evidencia, modelos y límites explícitos. Alcanzaste el Rango Dubalin 10 de Astronomía.</string>
