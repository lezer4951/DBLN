<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/dubalin_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_idiomas" android:textSize="28sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_languages_desc" android:textSize="16sp" android:textColor="@color/dubalin_ink_soft" android:layout_marginTop="6dp" android:layout_marginBottom="20dp" android:lineSpacingExtra="3dp" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="horizontal" android:gravity="top">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@color/dubalin_green_soft" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_cards" app:tint="@color/dubalin_green" android:padding="10dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_language_card" android:textSize="18sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_language_card_desc" android:textSize="15sp" android:textColor="@color/dubalin_ink_soft" android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_language_cards" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ui_study" android:textColor="@color/dubalin_green" app:backgroundTint="@color/dubalin_green_soft" app:cornerRadius="15dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="18dp" android:background="@drawable/bg_info_panel" android:orientation="horizontal" android:gravity="top">
            <ImageView android:layout_width="38dp" android:layout_height="38dp" android:backgroundTint="@color/md_on_primary" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_info" app:tint="@color/md_primary" android:padding="10dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_language_routes" android:textSize="16sp" android:textColor="@color/md_primary" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_language_routes_desc" android:textSize="14sp" android:textColor="@color/md_on_primary_container" android:layout_marginTop="4dp" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
