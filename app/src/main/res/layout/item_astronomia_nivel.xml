<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Dubalin.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="17dp">

        <TextView
            android:id="@+id/level_number"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_icon_tile"
            android:backgroundTint="@color/astronomy_blue_soft"
            android:gravity="center"
            android:textColor="@color/astronomy_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/level_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dubalin_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/level_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/dubalin_ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/level_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:textColor="@color/astronomy_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableTint="@color/astronomy_blue" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
