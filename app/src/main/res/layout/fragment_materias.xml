<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FAF9FD">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/subjects_toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:title="@string/subjects_title" app:titleTextColor="#1B1A22"
        app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="#57546A" app:navigationContentDescription="@string/action_back" />
<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/rvMaterias"
    android:layout_width="match_parent"
    android:layout_height="0dp" android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp" />
</LinearLayout>
