<TextView android:id="@+id/price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/dubalin_ink_soft" android:textSize="13sp" />
<com.google.android.material.button.MaterialButton android:id="@+id/buy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:textAllCaps="false" android:textSize="13sp" app:cornerRadius="14dp" />
</LinearLayout></com.google.android.material.card.MaterialCardView>