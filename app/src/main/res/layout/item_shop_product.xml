<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/dubalin_line" app:cardBackgroundColor="@color/md_surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
<FrameLayout android:id="@+id/stage" android:layout_width="match_parent" android:layout_height="128dp" android:background="@drawable/bg_product_stage">
<ImageView android:id="@+id/art" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center" android:padding="10dp" android:importantForAccessibility="no" />
<TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="8dp" android:padding="6dp" android:background="@drawable/bg_info_panel" android:textColor="@color/md_primary" android:textSize="10sp" android:textStyle="bold" />
</FrameLayout>
