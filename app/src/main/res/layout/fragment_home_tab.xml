<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/dubalin_canvas">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_home_eyebrow" android:textSize="14sp" android:textColor="@color/md_primary" android:textStyle="bold" />
                <TextView android:id="@+id/tv_saludo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="28sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" android:accessibilityHeading="true" />
            </LinearLayout>
            <TextView android:id="@+id/tv_avatar" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/dubalin_white" android:background="@drawable/bg_circle_primary" android:importantForAccessibility="no" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/dubalin_rank_bg">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_experience" android:textSize="13sp" android:textColor="@color/dubalin_ink_soft" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_nivel_xp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="18sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="44dp" android:background="@color/dubalin_line" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_streak" android:textSize="13sp" android:textColor="@color/dubalin_ink_soft" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_racha_dias" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="18sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tv_level_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="6dp" android:text="" android:textStyle="bold" android:textColor="@color/md_primary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="24dp" android:orientation="vertical" android:background="@drawable/bg_hero_gradient">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_hero_title" android:textSize="27sp" android:textColor="@color/dubalin_white" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_home_detail" android:textSize="15sp" android:textColor="@color/dubalin_white" android:layout_marginTop="12dp" android:lineSpacingExtra="2dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_home_subjects" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_explore" android:textColor="@color/dubalin_hero_ink" app:backgroundTint="@color/dubalin_white" app:cornerRadius="16dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ref_your_subjects" android:textSize="20sp" android:textColor="@color/dubalin_ink" android:layout_weight="1" android:textStyle="bold" />
            <TextView android:id="@+id/btn_home_all_subjects" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="@string/ref_all" android:textStyle="bold" android:textColor="@color/md_primary" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="112dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="96dp" android:id="@+id/home_subject_math" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:padding="10dp" android:orientation="vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:backgroundTint="@color/dubalin_brand" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_math" app:tint="@color/dubalin_white" android:padding="10dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/subject_math" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/dubalin_ink_soft" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="112dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="96dp" android:id="@+id/home_subject_spanish" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:padding="10dp" android:orientation="vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:backgroundTint="@color/dubalin_pink" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_book" app:tint="@color/md_on_primary" android:padding="10dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/subject_spanish" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/dubalin_ink_soft" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="112dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="96dp" android:id="@+id/home_subject_english" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:padding="10dp" android:orientation="vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:backgroundTint="@color/dubalin_green" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_globe" app:tint="@color/md_on_primary" android:padding="10dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/subject_english" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/dubalin_ink_soft" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="112dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minHeight="96dp" android:id="@+id/home_subject_physics" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:padding="10dp" android:orientation="vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:backgroundTint="@color/dubalin_orange" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_atom" app:tint="@color/md_on_primary" android:padding="10dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/subject_physics" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/dubalin_ink_soft" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="🔥" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/accent_racha" android:backgroundTint="@color/dubalin_orange_soft" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                        <TextView android:id="@+id/tv_streak_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="17sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_study_today" android:textSize="13sp" android:textColor="@color/dubalin_ink_soft" android:id="@+id/tv_streak_detail" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/streak_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_tools" android:textSize="20sp" android:textColor="@color/dubalin_ink" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.Dubalin.CardView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="horizontal" android:gravity="top">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:backgroundTint="@color/dubalin_green_soft" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_ref_cards" app:tint="@color/dubalin_green" android:padding="10dp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_flashcards_lab" android:textSize="18sp" android:textColor="@color/dubalin_ink" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ref_flashcards_desc" android:textSize="15sp" android:textColor="@color/dubalin_ink_soft" android:layout_marginTop="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_home_flashcards" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ui_study" android:textColor="@color/dubalin_green" app:backgroundTint="@color/dubalin_green_soft" app:cornerRadius="15dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
