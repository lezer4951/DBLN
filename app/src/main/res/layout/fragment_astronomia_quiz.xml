<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dubalin_canvas"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/quiz_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:title="@string/astronomy_quiz_title"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/quiz_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="20"
        app:indicatorColor="@color/astronomy_blue"
        app:trackColor="@color/astronomy_blue_soft"
        app:trackCornerRadius="4dp"
        app:trackThickness="7dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/quiz_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/quiz_counter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/astronomy_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quiz_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/dubalin_ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/quiz_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/option_a"
                        style="@style/Widget.Dubalin.QuizOption" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/option_b"
                        style="@style/Widget.Dubalin.QuizOption" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/option_c"
                        style="@style/Widget.Dubalin.QuizOption" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/option_d"
                        style="@style/Widget.Dubalin.QuizOption" />
                </RadioGroup>

                <TextView
                    android:id="@+id/quiz_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_info_panel"
                    android:lineSpacingExtra="2dp"
                    android:padding="16dp"
                    android:textColor="@color/dubalin_ink"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/quiz_saving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_quiz_action"
                    style="@style/Widget.Dubalin.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/astronomy_check_answer" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/quiz_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/result_icon"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="@color/astronomy_star_soft"
                    android:gravity="center"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:textColor="@color/dubalin_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/astronomy_blue"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/result_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/dubalin_ink_soft"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_quiz_finish"
                    style="@style/Widget.Dubalin.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/astronomy_back_to_route" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_quiz_retry"
                    style="@style/Widget.Dubalin.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/astronomy_retry_exam" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
