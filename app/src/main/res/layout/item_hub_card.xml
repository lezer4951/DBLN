<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Dubalin.CardView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
        <ImageView android:id="@+id/hub_icon" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_icon_tile" android:importantForAccessibility="no" app:srcCompat="@drawable/ic_nav_autoestudio" app:tint="?attr/colorPrimary"/>
        <TextView android:id="@+id/hub_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="?attr/colorOnSurface" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/hub_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Dubalin.Body"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
